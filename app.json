{
  "expo": {
    "name": "OmniHR",
    "slug": "omnihr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/veda-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/veda-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/veda-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "OmniHR",
      "favicon": "./assets/veda-logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
